# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# Then start local Supabase and run migrations:
#   pnpm supabase:start
#   pnpm drizzle:migrate
#
# Remote prod/sandbox values live in .env.production.local (gitignored) or CI secrets.

# Postgres (Drizzle) — local Supabase default
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Auth + Storage — local Supabase default (same keys for every local CLI install)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# App URL (metadata, OG links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — remote Supabase only
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_IMAGE_TRANSFORM=true
