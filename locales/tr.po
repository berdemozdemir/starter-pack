#: app/[language]/(public)/page.tsx:10
msgid "A clone-and-ship Next.js foundation with auth, locale-prefixed routes, oRPC, Drizzle, and TanStack Query conventions."
msgstr "Kimlik doğrulama, dil önekli rotalar, oRPC, Drizzle ve TanStack Query kurallarıyla clone-and-ship bir Next.js temeli."

#: modules/landing/components/Page.tsx:98
msgid "Typed procedures instead of Next.js server actions. Handlers return ok / err — they do not throw."
msgstr "Next.js server action yerine tipli procedure’lar. Handler’lar ok / err döner — throw etmez."

#: modules/landing/components/Page.tsx:49
msgid "Dashboard"
msgstr "Kontrol paneli"

#: modules/landing/components/Page.tsx:107
msgid "Local Supabase, timestamps, soft delete, RLS lockdown on app tables. Auth stays in oRPC, not table policies."
msgstr "Yerel Supabase, timestamp’ler, soft delete, uygulama tablolarında RLS kilidi. Auth oRPC’de kalır, tablo policy’lerinde değil."

#: modules/landing/components/Page.tsx:116
msgid "service_* objects with usePublicQuery / useSessionQuery. Unbounded lists use useSessionInfiniteQuery and a createdAt + id cursor — see the example dashboard."
msgstr "usePublicQuery / useSessionQuery ile service_* nesneleri. Sınırsız listeler useSessionInfiniteQuery ve createdAt + id cursor kullanır — örnek panoya bakın."

#: modules/landing/components/Page.tsx:79
msgid "Login, signup, password reset, member/admin roles. Layouts call requireAuth / requireAdmin; oRPC procedures gate the API."
msgstr "Giriş, kayıt, parola sıfırlama, member/admin rolleri. Layout’lar requireAuth / requireAdmin çağırır; oRPC procedure’lar API’yi kapılar."

